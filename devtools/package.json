{
  "name": "hisui-devtools",
  "version": "0.0.0",
  "private": true,
  "description": "Hisui DevTools",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
