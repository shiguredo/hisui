    "cleanup": "git clean -ffdx --exclude .env"
  },
  "dependencies": {
    "@preact/signals": "2.10.0",
    "preact": "10.29.7",
    "preact-iso": "2.12.1"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.4.1",
    "@playwright/test": "1.62.0",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@vitest/browser-playwright": "catalog:",
    "dotenv": "17.4.2",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-preact": "1.0.0"
  },
  "engines": {
